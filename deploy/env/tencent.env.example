# 基础镜像仓库前缀，不含 https:// 或结尾斜杠；默认 Docker Hub。
# 腾讯云 CVM 可尝试 mirror.ccs.tencentyun.com；其他网络可尝试 public.ecr.aws/docker。
DOCKER_REGISTRY=docker.io

# 复制为腾讯云服务器项目根目录 .env 后填写。随机密钥按 README 命令追加，不要提交真实密钥。

ERP_DOMAIN=erp.example.com
ADMIN_DOMAIN=admin.example.com
API_DOMAIN=api.example.com
VITE_API_URL=https://api.example.com
CORS_ORIGINS=https://erp.example.com,https://admin.example.com
TLS_CERT_DIR=/opt/haitoo/certs
LOGIN_CLIENT_IP_SOURCE=auto

# R2 可继续作为图片存储；它与 Cloudflare Tunnel 相互独立。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=haitoo-images-prod
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=https://img.example.com
AI_GENERATED_IMAGE_UPLOAD_TO_R2=true

# 自动上品 Excel 使用独立私有桶；配置 hub-exports/ 前缀 7 天删除规则。
R2_HUB_EXPORT_BUCKET=
