# 复制为项目根目录 .env 后填写。随机密钥按 README 命令追加，不要提交真实密钥。

CLOUDFLARE_TUNNEL_TOKEN=<cloudflare-tunnel-token>
VITE_API_URL=https://api.haitoro.com
CORS_ORIGINS=https://erp.haitoro.com,https://admin.haitoro.com
LOGIN_CLIENT_IP_SOURCE=auto

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=haitoo-images-prod
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=https://img.haitoro.com

# 自动上品 Excel 使用独立私有桶；配置 hub-exports/ 前缀 7 天删除规则。
R2_HUB_EXPORT_BUCKET=

# Grsai 直存：只给 Grsai 授权独立 pending 桶；该桶全桶配置30天删除和独立短缓存域名。
# ERP 的 AI 存储凭据须可访问 pending 和正式图片两个桶；不替换上述旧 R2 凭据。
GRSAI_DIRECT_STORAGE_ENABLED=false
R2_AI_PENDING_BUCKET=
R2_AI_PENDING_PUBLIC_BASE_URL=
R2_AI_STORAGE_ACCESS_KEY_ID=
R2_AI_STORAGE_SECRET_ACCESS_KEY=
IMAGE_PREPARE_CONCURRENCY=4
IMAGE_PREPARE_COMPANY_CONCURRENCY=2
IMAGE_PREPARE_LEASE_SECONDS=90
