# 基础镜像仓库前缀，不含 https:// 或结尾斜杠；默认 Docker Hub。
# 本机使用 DaoCloud 国内镜像源；可按网络情况改为其他提供 library 镜像的仓库。
DOCKER_REGISTRY=docker.m.daocloud.io

# 本机测试专用。复制为项目根目录 .env.local，并用随机值填写四个密钥。
# 不要复制腾讯云 .env 的数据库密码、登录密钥或生产 R2 凭据。
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
SECRET_KEY=
CREDENTIAL_ENCRYPTION_KEY=

VITE_API_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
LOGIN_CLIENT_IP_SOURCE=peer

# 需要测试上传时，填写独立测试 Bucket 与对应凭据、公开域名及 CORS 规则。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=haitoo-images-test
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=

# 如需真实调用第三方服务，使用测试账号或受限密钥单独配置。
GRSAI_BASE_URL=https://grsaiapi.com

# 自动上品 Excel 使用独立私有桶；配置 hub-exports/ 前缀 7 天删除规则。
R2_HUB_EXPORT_BUCKET=

# 货盘复用上述私有桶，supply-exports/ 的文件保留30天，勿套用Hub前缀7天规则。
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 标题 Worker 同时处理的任务数、整个进程的标题/提词并发总上限。
TITLE_WORKER_CONCURRENCY=3
TITLE_ITEM_CONCURRENCY=10
SUPPLY_WORKER_CONCURRENCY=4
SUPPLY_COMPANY_CONCURRENCY=2
SUPPLY_TITLE_CONCURRENCY=3
SUPPLY_IMAGE_CONCURRENCY=4
SUPPLY_HEARTBEAT_SECONDS=15
SUPPLY_LEASE_SECONDS=90
SUPPLY_FILE_RETENTION_DAYS=7

# Grsai 直存：只给 Grsai 授权独立 pending 桶；该桶全桶配置30天删除和独立短缓存域名。
# ERP 的 AI 存储凭据须可访问 pending 和正式图片两个桶；不替换上述旧 R2 凭据。
GRSAI_DIRECT_STORAGE_ENABLED=false
R2_AI_PENDING_BUCKET=
R2_AI_PENDING_PUBLIC_BASE_URL=
R2_AI_STORAGE_ACCESS_KEY_ID=
R2_AI_STORAGE_SECRET_ACCESS_KEY=
IMAGE_PREPARE_CONCURRENCY=4
IMAGE_PREPARE_COMPANY_CONCURRENCY=2
IMAGE_PREPARE_LEASE_SECONDS=90
